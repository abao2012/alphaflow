# AlphaFlow 环境变量配置
# 复制此文件为 .env 并填写你的实际值
# cp .env.example .env

# ── QMT 连接 ──────────────────────────────────────────────────
# QMT 客户端的 site-packages 路径（xtdata 所在目录）
# 例如: D:/你的券商名称QMT实盘 - 交易终端/bin.x64/Lib/site-packages
ALPHAFLOW_QMT_SITE_PACKAGES=

# QMT 客户端的 userdata_mini 路径
# 例如: D:/你的券商名称QMT实盘 - 交易终端/userdata_mini
ALPHAFLOW_QMT_USERDATA_PATH=

# QMT 资金账号
ALPHAFLOW_QMT_ACCOUNT_ID=

# QMT session ID（默认 101）
ALPHAFLOW_QMT_SESSION_ID=101

# ── 交易模式 ──────────────────────────────────────────────────
# 建议模式（只给建议，不下单）
ALPHAFLOW_ADVISORY_ONLY_MODE=true

# 是否允许提交订单
ALPHAFLOW_ENABLE_ORDER_SUBMISSION=false

# ── 服务配置 ──────────────────────────────────────────────────
# 服务监听地址
ALPHAFLOW_HOST=127.0.0.1

# 服务端口
ALPHAFLOW_PORT=8710

# 最大总仓位比例
ALPHAFLOW_MAX_TOTAL_EXPOSURE=0.8

# 单股最大仓位比例
ALPHAFLOW_MAX_SINGLE_POSITION=0.3

# ── PostgreSQL 缓存层（可选） ──────────────────────────────────
# 如果不配置则禁用数据库缓存，直接从 QMT 读取数据
ALPHAFLOW_DB_HOST=localhost
ALPHAFLOW_DB_PORT=5432
ALPHAFLOW_DB_USER=postgres
ALPHAFLOW_DB_PASSWORD=
ALPHAFLOW_DB_NAME=quant

# ── QMT 调用超时 ──────────────────────────────────────────────
# 单次 QMT 调用超时秒数
ALPHAFLOW_QMT_CALL_TIMEOUT=15

# 批量查询最大股票数
ALPHAFLOW_QMT_MAX_BATCH=20

# 主线评分缓存 TTL（秒）
ALPHAFLOW_MAINLINE_SCORE_CACHE_TTL=30
